{
  "name": "dsh-history-message-editor",
  "version": "1.2.0",
  "description": "在当前 DSH 会话内覆盖历史消息并重新生成回复，也可以重试某一轮。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreamYuande/dsh-history-message-editor.git"
  },
  "homepage": "https://github.com/DreamYuande/dsh-history-message-editor#readme",
  "bugs": { "url": "https://github.com/DreamYuande/dsh-history-message-editor/issues" },
  "keywords": ["dsh-plugin", "deepseek-harness", "session", "history", "message-editing"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "src/history.js", "dist/client.js", "cordis.patch.yml", "locale", "README.md"],
  "engines": { "dsh": "0.2.2-rc.5" },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test",
    "prepack": "node build.mjs"
  }
}
